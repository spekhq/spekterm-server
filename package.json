{
  "name": "spekterm-server",
  "version": "0.3.0",
  "description": "A small self-hosted server that lets spekterm users hand work to each other.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "bin": {
    "spekterm-server-admin": "./bin/spekterm-server-admin"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "admin": "node --disable-warning=ExperimentalWarning src/admin.ts",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.9.0"
  }
}
